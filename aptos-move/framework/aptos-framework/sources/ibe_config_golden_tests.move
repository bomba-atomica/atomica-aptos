        let total_weight = 5;

        // Submit shares from validators 1, 2, 3, 4
        ibe_config::submit_dk_share_for_testing(timelock_id, dk_share_0, 1, @0x1, 1, total_weight);
        assert!(!ibe_config::is_revealed(timelock_id), 1);

        ibe_config::submit_dk_share_for_testing(timelock_id, dk_share_1, 2, @0x2, 1, total_weight);
        assert!(!ibe_config::is_revealed(timelock_id), 2);

        ibe_config::submit_dk_share_for_testing(timelock_id, dk_share_2, 3, @0x3, 1, total_weight);
        assert!(!ibe_config::is_revealed(timelock_id), 3);


{
  "name": "@atomica/timelock-tests",
  "version": "0.1.0",
  "description": "TypeScript test suite for timelock and DKG functionality",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "bun run test-runner.ts round-robin",
    "test:parallel": "bun run test-runner.ts breadth-first",
    "test:basic": "bun run src/test-basic.ts",
    "test:ibe": "bun run src/test-ibe.ts",
    "test:framework": "bun run src/test-framework-compilation.ts",
    "test-runner": "bun run src/test-runner.ts",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint src/ test/ --fix"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testTimeout": 300000,
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!docker-test-harness/)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.ts"
    ]
  },
  "dependencies": {
    "aptos": "^1.22.1",
    "@atomica/docker-test-harness": "file:../docker-test-harness"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3",
    "eslint": "^9.39.2",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0"
  }
}

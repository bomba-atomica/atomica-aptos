# Atomica Aptos Validator Node - Prebuilt Binary
#
# This Dockerfile downloads a prebuilt aptos binary from GitHub releases
# instead of building from source, reducing build time and resource usage.
#
# Build context: repository root
#
# Build args:
#   BUILD_DATE: Build timestamp
#   GIT_SHA: Git commit hash
#   BINARY_RELEASE_TAG: GitHub release tag for the binary (e.g., binary-abc1234)
#   GITHUB_REPOSITORY: GitHub repository (e.g., owner/repo)

FROM debian:bullseye-slim

ARG TARGETARCH=amd64
ARG GIT_SHA
ARG BINARY_RELEASE_TAG
ARG GITHUB_REPOSITORY

# Validate required build args
RUN if [ -z "$GIT_SHA" ]; then \
        echo "Error: GIT_SHA build arg is required"; \
        exit 1; \
    fi && \
    if [ -z "$BINARY_RELEASE_TAG" ]; then \
        echo "Error: BINARY_RELEASE_TAG build arg is required"; \
        exit 1; \
    fi && \
    if [ -z "$GITHUB_REPOSITORY" ]; then \
        echo "Error: GITHUB_REPOSITORY build arg is required"; \
        exit 1; \
    fi

# Install runtime dependencies (matching aptos debian-base + libdw1)
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    iproute2 \
    libpq5 \
    libssl1.1 \
    libdw1 \
    && rm -rf /var/lib/apt/lists/*

# Add Tini to make sure the binaries receive proper SIGTERM signals when Docker is shut down
ADD --chmod=755 https://github.com/krallin/tini/releases/download/v0.19.0/tini-${TARGETARCH} /tini

# Create aptos user
RUN groupadd -g 6180 aptos && \
    useradd -u 6180 -g aptos -s /bin/bash -m aptos

# Download prebuilt binary from GitHub releases
RUN BINARY_URL="https://github.com/${GITHUB_REPOSITORY}/releases/download/${BINARY_RELEASE_TAG}/aptos-${GIT_SHA}" && \
    CHECKSUM_URL="https://github.com/${GITHUB_REPOSITORY}/releases/download/${BINARY_RELEASE_TAG}/aptos-${GIT_SHA}.sha256" && \
    echo "Downloading binary from: $BINARY_URL" && \
    curl -L -o /tmp/aptos "$BINARY_URL" && \
    curl -L -o /tmp/aptos.sha256 "$CHECKSUM_URL" && \
    echo "Verifying checksum..." && \
    cd /tmp && \
    sha256sum -c aptos.sha256 && \
    mv /tmp/aptos /usr/local/bin/aptos && \
    chmod +x /usr/local/bin/aptos && \
    rm -f /tmp/aptos.sha256

# Verify the binary works
RUN /usr/local/bin/aptos --version

# Create data directory
RUN mkdir -p /opt/aptos/var && \
    chown -R aptos:aptos /opt/aptos

# Add build metadata
ARG BUILD_DATE
ENV BUILD_DATE=${BUILD_DATE}
ENV GIT_SHA=${GIT_SHA}
ENV BINARY_RELEASE_TAG=${BINARY_RELEASE_TAG}

# Expose ports
EXPOSE 6180 6181 6182 8080 9101

# Set working directory
WORKDIR /opt/aptos

# Run as aptos user
USER aptos

# Health check
HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:8080/v1 || exit 1

# Use Tini as entrypoint for proper signal handling
ENTRYPOINT ["/tini", "--", "/usr/local/bin/aptos"]
CMD ["--help"]

# Atomica Aptos Validator Node - Local Development Build
#
# This Dockerfile is optimized for local development:
# - Uses BuildKit cache mounts for fast incremental builds
# - Builds only aptos-node binary (skips CLI to save time)
#
# Build context: atomica-aptos repository root
# Requires: Docker BuildKit enabled (DOCKER_BUILDKIT=1)
#
# Build command from atomica/docker:
#   ./build-local-image.sh
#
# Or manually:
#   docker buildx build \
#     -f atomica/docker/Dockerfile.local \
#     -t atomica-validator:local \
#     --progress=plain \
#     .

# Stage 1: Build the aptos-node binary
FROM rust:1.75-bullseye AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    clang \
    libssl-dev \
    pkg-config \
    libpq-dev \
    lld \
    libudev-dev \
    libdw-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build/atomica-aptos

# Copy source
COPY . .

# Build arguments
ARG GIT_SHA=local-dev
ARG PROFILE=release
ARG FEATURES="testing"

RUN echo "Building Atomica Aptos (local) from: ${GIT_SHA}"
RUN echo "Profile: ${PROFILE}, Features: ${FEATURES}"

# Build aptos-node validator (ONLY - don't build CLI to save time)
# Optimizations:
# - thin LTO for faster builds while maintaining good performance
# - codegen-units=16 for parallel compilation
# - Uses BuildKit cache mounts to persist cargo registry and build artifacts
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/build/atomica-aptos/target,sharing=locked \
    CARGO_PROFILE_RELEASE_LTO=thin \
    CARGO_PROFILE_RELEASE_CODEGEN_UNITS=16 \
    cargo build --${PROFILE} --bin aptos-node --features ${FEATURES} && \
    cp target/${PROFILE}/aptos-node /build/aptos-node

# Stage 2: Runtime image (minimal)
FROM debian:bullseye-slim

ARG TARGETARCH=amd64

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    iproute2 \
    libpq5 \
    libssl1.1 \
    libdw1 \
    && rm -rf /var/lib/apt/lists/*

# Add Tini for proper signal handling
ADD --chmod=755 https://github.com/krallin/tini/releases/download/v0.19.0/tini-${TARGETARCH} /tini

# Create aptos user
RUN groupadd -g 6180 aptos && \
    useradd -u 6180 -g aptos -s /bin/bash -m aptos

# Copy binaries from builder
COPY --from=builder /build/aptos-node /usr/local/bin/aptos-node

# Set permissions
RUN chmod +x /usr/local/bin/aptos-node

# Create data directory
RUN mkdir -p /opt/aptos/var /opt/aptos/data && \
    chown -R aptos:aptos /opt/aptos

# Add build metadata
ARG BUILD_DATE
ARG GIT_SHA=local-dev
ENV BUILD_DATE=${BUILD_DATE}
ENV GIT_SHA=${GIT_SHA}

# Expose ports
EXPOSE 6180 6181 6182 8080 9101

# Set working directory
WORKDIR /opt/aptos

# Run as aptos user
USER aptos

# Health check
HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:8080/v1 || exit 1

# Use Tini as entrypoint
ENTRYPOINT ["/tini", "--", "/usr/local/bin/aptos-node"]
CMD []
